# STATE-Bench public-release environment template.
# Keep this file free of real keys and private endpoints. The official benchmark
# documentation defines the required locked simulator and judge settings.

# 1) Locked evaluation client. Required for the user simulator and judge.
# Deployments must point to GPT-5.4 for the locked evaluation protocol.
# Azure OpenAI endpoints are called through the OpenAI v1 API; no api-version is needed.
STATE_BENCH_EVAL_ENDPOINT="https://your-gpt54-resource.openai.azure.com"
STATE_BENCH_EVAL_DEPLOYMENTS="<your gpt 5.4 deployment name>"
# Optional. If omitted, Azure token auth is tried.
# STATE_BENCH_EVAL_API_KEY="<your gpt 5.4 resource api key>"

# 2) Built-in StateBenchAgent client. Required for the default runner path.
# Use any agent deployment/model you want to evaluate.
# Choose Azure OpenAI or OpenAI API settings.

# Azure OpenAI agent client:
# STATE_BENCH_AGENT_ENDPOINT="https://your-agent-resource.openai.azure.com"
# STATE_BENCH_AGENT_DEPLOYMENTS="<your agent deployment name>"
# Optional. If omitted, Azure token auth is tried.
# STATE_BENCH_AGENT_API_KEY="<your agent resource api key>"

# OpenAI API agent client:
# STATE_BENCH_AGENT_PROVIDER="openai"
# STATE_BENCH_AGENT_MODEL="<your OpenAI model>"
# STATE_BENCH_AGENT_API_KEY="<your OpenAI API key>"
# OPENAI_API_KEY is also accepted as a fallback.

# 3) Local Capybara first-round runner (non-official OpenAI-compatible path).
# These values are only for a local provider and must not be used to claim an
# official leaderboard result.
# STATE_BENCH_COMPAT_BASE_URL="https://your-openai-compatible-host/v1"
# STATE_BENCH_COMPAT_API_KEY="<your api key>"
STATE_BENCH_COMPAT_AGENT_MODEL="gpt-5.6-luna"
STATE_BENCH_COMPAT_EVAL_MODEL="gpt-5.4"
# CAPYBARA_SOURCE_PROJECT="<path to the local Capybara project>"
# CAPYBARA_MAIN_REPO="<path to the Capybara repository>"
