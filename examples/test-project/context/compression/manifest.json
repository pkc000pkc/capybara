{
  "version": 1,
  "id": "default",
  "name": "Default context compressor",
  "description": "Summarizes completed historical turns as a validated semantic patch.",
  "entry": "prompt.j2",
  "policy": {
    "trigger_ratio": 0.75,
    "target_ratio": 0.55,
    "preserve_recent_turns": 2,
    "max_source_tokens": 12000,
    "max_output_tokens": 2000,
    "retry_limit": 2,
    "apply_mode": "debug"
  }
}
