{
  "version": 1,
  "package": "project-files",
  "runner": {
    "type": "stdio",
    "entry": "runner.mjs"
  },
  "tools": [
    {
      "name": "read_file",
      "description": "Read a UTF-8 text file from the project workspace with an optional line range.",
      "permissions": ["filesystem:read"],
      "sideEffects": "none",
      "replay": "safe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_name": { "type": "string", "minLength": 1 },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "include_line_numbers": { "type": "boolean" }
        },
        "required": ["file_name"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["path", "start_line", "end_line", "lines", "content"],
        "properties": {
          "path": { "type": "string" },
          "start_line": { "type": "integer" },
          "end_line": { "type": "integer" },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line", "text"],
              "properties": { "line": { "type": "integer" }, "text": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      },
      "examples": [{ "file_name": ".capybara/config.json", "include_line_numbers": false }]
    },
    {
      "name": "list_files",
      "description": "List files and directories inside the project workspace.",
      "permissions": ["filesystem:read"],
      "sideEffects": "none",
      "replay": "safe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "recursive": { "type": "boolean" },
          "max_entries": { "type": "integer", "minimum": 1, "maximum": 5000 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["path", "entries", "truncated"],
        "properties": {
          "path": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "type"],
              "properties": {
                "path": { "type": "string" },
                "type": { "type": "string", "enum": ["file", "directory"] }
              },
              "additionalProperties": false
            }
          },
          "truncated": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "examples": [{ "path": ".", "recursive": false }]
    },
    {
      "name": "search_file",
      "description": "Search project file names or text content and return matching paths and lines.",
      "permissions": ["filesystem:read"],
      "sideEffects": "none",
      "replay": "safe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "dir": { "type": "string" },
          "mode": { "type": "string", "enum": ["filename", "content"] },
          "max_matches": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "case_sensitive": { "type": "boolean" }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["query", "mode", "matches", "truncated"],
        "properties": {
          "query": { "type": "string" },
          "mode": { "type": "string", "enum": ["filename", "content"] },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string" },
                "line": { "type": "integer" },
                "text": { "type": "string" },
                "before": { "$ref": "#/$defs/lines" },
                "after": { "$ref": "#/$defs/lines" }
              },
              "additionalProperties": false
            }
          },
          "truncated": { "type": "boolean" }
        },
        "$defs": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line", "text"],
              "properties": { "line": { "type": "integer" }, "text": { "type": "string" } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "examples": [{ "query": "main_template", "mode": "content" }]
    },
    {
      "name": "search_in_file",
      "description": "Search one project text file and return matching lines with surrounding context.",
      "permissions": ["filesystem:read"],
      "sideEffects": "none",
      "replay": "safe",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_name": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 1 },
          "context_lines": { "type": "integer", "minimum": 0, "maximum": 20 },
          "max_matches": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "case_sensitive": { "type": "boolean" }
        },
        "required": ["file_name", "query"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["path", "query", "matches"],
        "properties": {
          "path": { "type": "string" },
          "query": { "type": "string" },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line", "text", "before", "after"],
              "properties": {
                "line": { "type": "integer" },
                "text": { "type": "string" },
                "before": { "$ref": "#/$defs/lines" },
                "after": { "$ref": "#/$defs/lines" }
              },
              "additionalProperties": false
            }
          }
        },
        "$defs": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line", "text"],
              "properties": { "line": { "type": "integer" }, "text": { "type": "string" } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "examples": [{ "file_name": ".capybara/config.json", "query": "max_tool_rounds" }]
    },
    {
      "name": "write_file",
      "description": "Create or update one project text file using content, append, or a unified diff patch.",
      "permissions": ["filesystem:write"],
      "sideEffects": "workspace-write",
      "replay": "confirm",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_name": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "mode": { "type": "string", "enum": ["overwrite", "append"] },
          "patch": { "type": "string", "minLength": 1 }
        },
        "required": ["file_name"],
        "oneOf": [
          { "required": ["content"], "not": { "required": ["patch"] } },
          { "required": ["patch"], "not": { "required": ["content"] } }
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["path", "mode", "bytes"],
        "properties": {
          "path": { "type": "string" },
          "mode": { "type": "string", "enum": ["overwrite", "append", "patch"] },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "examples": [{ "file_name": "notes/example.txt", "content": "Example\n", "mode": "overwrite" }]
    },
    {
      "name": "delete_file",
      "description": "Delete one file inside the project workspace.",
      "permissions": ["filesystem:delete"],
      "sideEffects": "workspace-write",
      "replay": "confirm",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_name": { "type": "string", "minLength": 1 }
        },
        "required": ["file_name"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["path", "deleted"],
        "properties": {
          "path": { "type": "string" },
          "deleted": { "const": true }
        },
        "additionalProperties": false
      },
      "examples": [{ "file_name": "notes/example.txt" }]
    },
    {
      "name": "run_code",
      "description": "Execute one code file inside the project workspace and capture its bounded output. The project tool timeout remains the outer execution limit.",
      "permissions": ["process:execute"],
      "sideEffects": "external",
      "replay": "never",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_name": { "type": "string", "minLength": 1 },
          "runtime": { "type": "string", "enum": ["auto", "node", "python", "powershell", "bash"] },
          "args": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "maxLength": 10000 }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 600000 }
        },
        "required": ["file_name"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["path", "runtime", "cwd", "exit_code", "signal", "stdout", "stderr", "stdout_truncated", "stderr_truncated", "timed_out", "duration_ms"],
        "properties": {
          "path": { "type": "string" },
          "runtime": { "type": "string", "enum": ["node", "python", "powershell", "bash"] },
          "cwd": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] },
          "signal": { "type": ["string", "null"] },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "stdout_truncated": { "type": "boolean" },
          "stderr_truncated": { "type": "boolean" },
          "timed_out": { "type": "boolean" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "examples": [{ "file_name": "scripts/check.mjs", "args": ["--verbose"], "timeout_ms": 10000 }]
    },
    {
      "name": "run_command",
      "description": "Run one shell command from a project workspace directory and capture its bounded output. Shell syntax is supported and the project tool timeout remains the outer execution limit.",
      "permissions": ["process:execute"],
      "sideEffects": "external",
      "replay": "never",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "cwd": { "type": "string", "minLength": 1 },
          "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 600000 }
        },
        "required": ["command"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["command", "cwd", "exit_code", "signal", "stdout", "stderr", "stdout_truncated", "stderr_truncated", "timed_out", "duration_ms"],
        "properties": {
          "command": { "type": "string" },
          "cwd": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] },
          "signal": { "type": ["string", "null"] },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "stdout_truncated": { "type": "boolean" },
          "stderr_truncated": { "type": "boolean" },
          "timed_out": { "type": "boolean" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "examples": [{ "command": "node --version", "timeout_ms": 10000 }]
    }
  ]
}
