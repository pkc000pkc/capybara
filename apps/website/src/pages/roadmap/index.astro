---
import CapybaraMark from "../../components/CapybaraMark.astro";
import "../../styles/global.css";
import "../../styles/roadmap.css";

const base = import.meta.env.BASE_URL;
const repositoryUrl = "https://github.com/pkc000pkc/capybara";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const title = "Roadmap | Capybara";
const description =
  "The Capybara roadmap: from a local-first agent workspace toward a persistent AI coworker with useful context, verified capabilities, and user control.";
const ogImage = new URL(`${base}images/runtime-overview.png`, Astro.site ?? Astro.url);
const updated = "2026-10-20";

const stages = [
  {
    id: "available",
    number: "01",
    label: "Available today",
    summary: "The engineering foundation",
    description: "What you can use in the existing developer workspace and local Runner.",
    items: [
      {
        title: "Context you can inspect",
        description:
          "Inspect context sources, project resources, tool calls, and execution state. Edit and debug what reaches the model.",
        area: "Context & control",
      },
      {
        title: "Local agents, your own interface",
        description:
          "Compose Plugins, Harnesses, Hooks, and shared Tools. Run a project without the developer UI and connect through the TypeScript Client SDK.",
        area: "Runner & SDK",
      },
      {
        title: "Experiments and replay",
        description:
          "Use datasets, correction workflows, source-task replay, variable snapshots, and held-out testing to examine changes.",
        area: "Training & evaluation",
      },
    ],
  },
  {
    id: "in-progress",
    number: "02",
    label: "In progress",
    summary: "Making the next step testable",
    description: "Active development and research. These are not yet a general product release.",
    items: [
      {
        title: "Frozen runtime and execution evidence",
        description:
          "Validate frozen plugin execution, scoped delegation, and evidence checks in research integrations before bringing them into everyday sessions.",
        area: "Runtime research",
      },
      {
        title: "Less context noise. Better waiting.",
        description:
          "Test selective retrieval, context cleanup, and event-driven waiting in GAIA2. Controlled checks pass; real-model end-to-end acceptance remains open.",
        area: "Research prototypes",
      },
      {
        title: "A desktop workspace for real projects",
        description:
          "Prototype projects, sessions, files, project apps, and work controls. The current concept is static, not an installable desktop product.",
        area: "Product prototype",
      },
    ],
  },
  {
    id: "next",
    number: "03",
    label: "Next",
    summary: "A coworker that carries work forward",
    description: "The next product priorities. Each needs a working, verifiable path before release.",
    items: [
      {
        title: "Capabilities built from real work",
        description:
          "Turn corrections and verified work into executable methods and resource packages. Test new inputs and regressions before adopting a candidate.",
        area: "Verified evolution",
      },
      {
        title: "Persistent project responsibilities",
        description:
          "Keep goals, instructions, and work across sessions and restarts. Resume authorized responsibilities from time or project events, with clear budgets and service-owned execution.",
        area: "Continuity",
      },
      {
        title: "Changes the user can direct",
        description:
          "Record corrections and when they take effect. Keep permissions explicit, show adopted versions, and let users withdraw a method without losing its history.",
        area: "Instructions & permissions",
      },
    ],
  },
  {
    id: "exploring",
    number: "04",
    label: "Exploring",
    summary: "Beyond the first complete workflow",
    description: "Directions to investigate after the core experience proves useful and reliable.",
    items: [
      {
        title: "More runtimes and deployment options",
        description:
          "Explore additional runtime adapters, always-on deployment, and team ownership after local workflows have passed reliability checks.",
        area: "Runtimes & deployment",
      },
      {
        title: "Portable projects and reusable methods",
        description:
          "Carry project state between supported environments and reuse vetted capabilities with fresh data bindings, permission checks, and reliable integrations.",
        area: "Portability & integrations",
      },
    ],
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical.toString(),
  dateModified: updated,
  isPartOf: { "@type": "WebSite", name: "Capybara", url: new URL(base, Astro.site ?? Astro.url).toString() },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f7f9f8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Capybara" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={base} aria-label="Capybara home">
          <CapybaraMark />
          <span class="brand-name">Capybara</span>
          <span class="brand-status">Open source</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={base}>Home</a>
          <a href={`${base}blog/`}>Blog</a>
          <a class="nav-current" href={`${base}roadmap/`} aria-current="page">Roadmap</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="roadmap-main">
      <div class="shell">
        <header class="roadmap-intro">
          <div>
            <p class="section-index">Capybara / Roadmap</p>
            <h1>A useful AI coworker.<br />One step at a time.</h1>
            <p class="roadmap-lead">
              We are building toward an AI coworker for your long-term projects:
              useful context, capabilities that improve with use, and you in control.
            </p>
          </div>
          <div class="roadmap-update">
            <span class="roadmap-meta-label">Last reviewed</span>
            <time datetime={updated}>20 October 2026</time>
            <p>Direction, not deadlines.<br />Priorities may change as we test and learn.</p>
          </div>
        </header>

        <nav class="roadmap-overview" aria-label="Roadmap sections">
          {stages.map((stage) => (
            <a href={`#${stage.id}`} class={`roadmap-stop roadmap-stop-${stage.id}`}>
              <span class="roadmap-stop-number">{stage.number}</span>
              <span class="roadmap-stop-label">{stage.label}</span>
              <span class="roadmap-stop-count">{stage.items.length} areas</span>
            </a>
          ))}
        </nav>

        <div class="roadmap-stages">
          {stages.map((stage) => (
            <section class={`roadmap-stage roadmap-stage-${stage.id}`} id={stage.id} aria-labelledby={`${stage.id}-title`}>
              <header class="roadmap-stage-heading">
                <p class="roadmap-stage-status"><span aria-hidden="true"></span>{stage.label}</p>
                <h2 id={`${stage.id}-title`}>{stage.summary}</h2>
                <p>{stage.description}</p>
              </header>
              <ol class="roadmap-items" aria-label={`${stage.label} priorities`}>
                {stage.items.map((item, index) => (
                  <li>
                    <span class="roadmap-item-number" aria-hidden="true">{stage.number}.{index + 1}</span>
                    <div>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                      <span class="roadmap-item-area">{item.area}</span>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>

        <aside class="roadmap-principles" aria-labelledby="roadmap-principles-title">
          <div>
            <p class="section-index">How we decide</p>
            <h2 id="roadmap-principles-title">Progress should leave evidence.</h2>
          </div>
          <div class="roadmap-principles-copy">
            <p>
              A completed run is not proof of useful work. A replay is not proof of generalization.
              A passing research check is not a product release or a new official benchmark result.
            </p>
            <p>
              We look for checkable outputs, independent tests, and changes users can understand
              and control. Learning a method must not silently expand its permissions.
            </p>
            <a class="text-link" href={`${base}blog/`}>Read the engineering notes <span aria-hidden="true">→</span></a>
          </div>
        </aside>

        <section class="roadmap-feedback" aria-labelledby="roadmap-feedback-title">
          <div>
            <h2 id="roadmap-feedback-title">What would make this useful to you?</h2>
            <p>Share a real project, a recurring task, or a failure you want us to understand.</p>
          </div>
          <a class="button button-primary" href={`${repositoryUrl}/issues`}>Share feedback on GitHub <span aria-hidden="true">↗</span></a>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="brand footer-brand" href={base} aria-label="Capybara home">
          <CapybaraMark />
          <span class="brand-name">Capybara</span>
        </a>
        <p>Useful context. Verified progress. User control.</p>
        <p>Apache-2.0 · 2026</p>
      </div>
    </footer>
  </body>
</html>
