{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gaia2-run-manifest-v1",
  "title": "GAIA2 frozen execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "generatedAt", "mode", "planFingerprint", "dataset", "models", "policy", "rootSeed", "requestedRuntime", "entrypoints", "lockRefs", "selection", "runRoot", "tasks", "stateFile", "executionBinding", "manifestHash"],
  "properties": {
    "schemaVersion": {"const": "gaia2-run-manifest-v1"},
    "runId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"},
    "generatedAt": {"type": "string"},
    "mode": {"enum": ["internal_pass5", "official_submission"]},
    "planFingerprint": {"$ref": "#/$defs/hash"},
    "manifestHash": {"$ref": "#/$defs/hash"},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "revision", "split"], "properties": {"kind": {"enum": ["source", "submission"]}, "id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "split": {"type": "string", "minLength": 1}}},
    "models": {"type": "object"},
    "policy": {"type": "object", "required": ["initialRunsPerScenario", "maxCorrections", "seedBinding", "learningPolicy"]},
    "rootSeed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "requestedRuntime": {"type": "object"},
    "entrypoints": {"type": "object"},
    "lockRefs": {"type": "object", "additionalProperties": false, "required": ["protocol", "environment", "capabilities", "dataset", "scenarioIndex"], "properties": {"protocol": {"$ref": "#/$defs/lockRef"}, "environment": {"$ref": "#/$defs/lockRef"}, "capabilities": {"$ref": "#/$defs/lockRef"}, "dataset": {"$ref": "#/$defs/lockRef"}, "scenarioIndex": {"$ref": "#/$defs/lockRef"}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["perCapability", "miniLimit", "expectedInitialExecutions", "fullOfficialCoverage"], "properties": {"perCapability": {"type": ["integer", "null"], "minimum": 1}, "miniLimit": {"type": ["integer", "null"], "minimum": 1}, "expectedInitialExecutions": {"type": "integer", "minimum": 1}, "fullOfficialCoverage": {"type": "boolean"}}},
    "runRoot": {"type": "string", "minLength": 1},
    "stateFile": {"type": "string", "minLength": 1},
    "executionBinding": {"enum": ["planning_only_pending_phase1_and_phase3", "manifest_driven_standard_only_real_hooks_pending_phase3", "phase3_live_plugin_host_required"]},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lockRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "config", "scenarioId", "rowIndex", "sourcePath", "scenarioHash", "scenarioVersion", "runNumber", "seed", "executionId", "attemptIndex", "correctionOrdinal", "outputDir", "fixtureDir", "workspaceDir"],
      "properties": {
        "phase": {"enum": ["standard", "agent2agent", "noise"]},
        "config": {"enum": ["execution", "search", "adaptability", "time", "ambiguity", "mini"]},
        "scenarioId": {"type": "string", "minLength": 1},
        "rowIndex": {"type": "integer", "minimum": 0},
        "sourcePath": {"type": "string", "minLength": 1},
        "scenarioHash": {"$ref": "#/$defs/hash"},
        "scenarioVersion": {"type": "string", "minLength": 1},
        "runNumber": {"type": "integer", "minimum": 1, "maximum": 5},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "executionId": {"type": "string", "minLength": 1},
        "attemptIndex": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "correctionOrdinal": {"const": 0},
        "outputDir": {"type": "string", "minLength": 1},
        "fixtureDir": {"type": "string", "minLength": 1},
        "workspaceDir": {"type": "string", "minLength": 1}
      }
    }
  }
}
